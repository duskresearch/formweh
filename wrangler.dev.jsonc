// Local test config only: no routes, so wrangler dev serves a plain localhost
// instance instead of simulating the formweh.com marketing host. Not deployed.
{
  "name": "formweh-devtest",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-01",
  "d1_databases": [
    { "binding": "DB", "database_name": "formweh-db", "database_id": "local-dev", "migrations_dir": "migrations" }
  ]
}
